@@ -20,25 +20,46 @@
         drupalSettings.antibot.human = false;
       }
 
+      // Provide a shared function to allow removing listeners.
+      const unlockFormsForHumans = (event) => {
+        // Act only if browser thinks this came from user interaction.
+        if (!event.isTrusted) {
+          return;
+        }
+
+        // For keyboard, only treat Tab/Enter as evidence of a human.
+        if (
+          event.type === 'keydown' &&
+          event.code !== 'Tab' &&
+          event.code !== 'Enter'
+        ) {
+          return;
+        }
+
+        // Unlock the forms.
+        Drupal.antibot.unlockForms();
+
+        document.body.removeEventListener('mousemove', unlockFormsForHumans);
+        document.body.removeEventListener('pointermove', unlockFormsForHumans);
+        document.body.removeEventListener('touchmove', unlockFormsForHumans);
+        document.body.removeEventListener('keydown', unlockFormsForHumans);
+        document.body.removeEventListener('click', unlockFormsForHumans, true);
+      };
+
       // Wait for a mouse to move, indicating they are human.
-      document.body.addEventListener('mousemove', () => {
-        // Unlock the forms.
-        Drupal.antibot.unlockForms();
-      });
+      document.body.addEventListener('mousemove', unlockFormsForHumans);
+
+      // Wait for a pointer to move, indicating they are human.
+      document.body.addEventListener('pointermove', unlockFormsForHumans);
 
       // Wait for a touch move event, indicating that they are human.
-      document.body.addEventListener('touchmove', () => {
-        // Unlock the forms.
-        Drupal.antibot.unlockForms();
-      });
+      document.body.addEventListener('touchmove', unlockFormsForHumans);
 
       // A tab or enter key pressed can also indicate they are human.
-      document.body.addEventListener('keydown', (e) => {
-        if (e.code === 'Tab' || e.code === 'Enter') {
-          // Unlock the forms.
-          Drupal.antibot.unlockForms();
-        }
-      });
+      document.body.addEventListener('keydown', unlockFormsForHumans);
+
+      // Some assistive technologies only click. Capture first event action.
+      document.body.addEventListener('click', unlockFormsForHumans, true);
     },
   };
 
