<?php

/**
 * @file
 * Contains nidirect_prisons.module.
 */

use Drupal\Core\Database\Database;
use Drupal\nidirect_prisons\Service\PrisonerPaymentManager;

/**
 * Implements hook_cron().
 */
function nidirect_prisons_cron() {

  /*
   * Enforce transaction timeouts.
   */

  /** @var \Drupal\nidirect_prisons\Service\PrisonerPaymentManager $payment_manager */
  $payment_manager = \Drupal::service('nidirect_prisons.prisoner_payment_manager');

  // Get all pending transactions and expire them if they have
  // timed out.
  $pending_transactions = $payment_manager->getPendingTransactions();

  if ($pending_transactions) {

    foreach ($pending_transactions as $transaction) {
      if ($payment_manager->expireIfTimedOut($transaction)) {
        \Drupal::logger('nidirect_prisons')->debug(
          'Cron expired transaction @order_key',
          ['@order_key' => $transaction->order_key]
        );
      }
    }
  }

  $payment_manager->processPendingPrismNotifications();

  $connection = Database::getConnection();

  // Delete all transactions more than 7 days old.
  $threshold = strtotime('-7 days');
  $query = $connection->delete('prisoner_payment_transactions')
    ->condition('created_timestamp', $threshold, '<');
  $deleted = $query->execute();

  if ($deleted) {
    \Drupal::logger('nidirect_prisons')->info('Deleted @count old prisoner payment transactions.', ['@count' => $deleted]);
  }

  // Recover stale processing notifications and stop retrying exhausted ones.
  $now = \Drupal::time()->getRequestTime();
  $stale_processing_threshold = $now - 1800;
  $stale_pending_threshold = $now - 86400;

  $recovered = $connection->update('prisoner_payment_notifications')
    ->fields([
      'status' => 'pending',
      'updated_timestamp' => $now,
      'last_error' => 'Recovered from stale processing state',
    ])
    ->condition('status', 'processing')
    ->condition('updated_timestamp', $stale_processing_threshold, '<')
    ->execute();

  if ($recovered) {
    \Drupal::logger('nidirect_prisons')->warning('Recovered @count stale Prism notifications from processing state.', ['@count' => $recovered]);
  }

  $exhausted = $connection->update('prisoner_payment_notifications')
    ->fields([
      'status' => 'failed',
      'updated_timestamp' => $now,
      'last_error' => 'Stopped retrying after max attempts and age threshold',
    ])
    ->condition('status', 'pending')
    ->condition('attempts', 10, '>=')
    ->condition('updated_timestamp', $stale_pending_threshold, '<')
    ->execute();

  if ($exhausted) {
    \Drupal::logger('nidirect_prisons')->warning('Marked @count exhaustively retried Prism notifications as failed.', ['@count' => $exhausted]);
  }

  // Delete all notifications more than 7 days old.
  $query = $connection->delete('prisoner_payment_notifications')
    ->condition('status', ['sent', 'failed'], 'IN')
    ->condition('created_timestamp', $threshold, '<');
  $deleted = $query->execute();

  if ($deleted) {
    \Drupal::logger('nidirect_prisons')->info('Deleted @count old prisoner payment notifications.', ['@count' => $deleted]);
  }



  // Log (hopefully very rare) cases where a prisoner has  // more than one pending transaction.
  $query = $connection->select('prisoner_payment_transactions', 'ppt');
  $query->addField('ppt', 'prisoner_id');
  $query->addExpression('COUNT(*)', 'pending_count');
  $query->condition('ppt.status', 'pending');
  $query->groupBy('ppt.prisoner_id');
  $query->having('COUNT(*) > :count', [':count' => 1]);

  $result = $query->execute();

  foreach ($result as $row) {

    // Fetch order keys for this prisoner.
    $orders = $connection->select('prisoner_payment_transactions', 'ppt')
      ->fields('ppt', ['order_key'])
      ->condition('prisoner_id', $row->prisoner_id)
      ->condition('status', 'pending')
      ->execute()
      ->fetchCol();

    \Drupal::logger('nidirect_prisons')->critical(
      'Invariant violation: @count pending transactions detected for prisoner @pid. Orders: @orders',
      [
        '@count' => $row->pending_count,
        '@pid' => $row->prisoner_id,
        '@orders' => implode(', ', $orders),
      ]
    );
  }

}

/**
 * Implements hook_mail().
 */
function nidirect_prisons_mail($key, &$message, $params) {
  switch ($key) {
    case 'prisoner_payment_notification':
      $message['subject'] = $params['subject'];
      $message['body'] = is_array($params['body']) ? $params['body'] : [$params['body']];
      $message['headers']['Content-Type'] = 'text/plain; charset=UTF-8';
      break;
  }
}
