<div id="school-closure-results">

  <p>{% trans %}Last updated{% endtrans %}: {{ updated|date('g.i a') }} on {{ updated|date('jS F Y') }}.</p>

  {% if closures|length > 0 %}
    {% for school in closures %}
    <div class="columnItem">
      <h3 data-transliterated="{{ school.altname }}" style="margin-bottom: 0">{{ school.name }}</h3>
      <em style="color: #717171; font-size: 0.92em">{{ school.location }}</em>

      <ul class="description">
        {% for closure in school.closures %}
        <li>
          {%- if closure.dateTo -%}
            {{ '@from to @to'|t({'@from': closure.date|date('l jS F Y'), '@to': closure.dateTo|date('l jS F Y')}) }}
          {%- else -%}
            {{ closure.date|date('l jS F Y') }}
          {%- endif %}
          - {{ closure.reason|t|default("") }}
        </li>
        {% endfor %}
      </ul>
    </div>
    <hr>
    {% endfor %}
  {% elseif error %}
    <p>{% trans %}Sorry, there was a problem with this service. Please contact your school for information on possible closures.{% endtrans %}</p>
  {% else %}
    <p>{% trans %}There are no school closures.{% endtrans %}</p>
  {% endif %}
</div>
